#!/usr/bin/env python3
"""claude-sessions: Claude Code sessions from BOTH config dirs
(~/.claude = `claude`, ~/.claude-alt = `claude-alt`), by last activity.
See README.txt.

  claude-sessions              newest 25 per section
  claude-sessions -n 0         everything
  claude-sessions notes        rows whose name, auto title, last prompt, folder or id match
  claude-sessions -r notes     ...each followed by the command that resumes it
  claude-sessions --tsv        TAB-separated cells, fitted to $LINES (for lockin)
"""
import json, os, sys, time

HOME = os.path.expanduser('~')
CONFIGS = [('MAIN', 'claude', os.path.join(HOME, '.claude')),
           ('ALT', 'claude-alt', os.path.join(HOME, '.claude-alt'))]
TAIL = 512 * 1024    # session metadata (titles, last prompt) is re-appended near the end
HEAD = 256 * 1024    # first entries carry the cwd
FULL_SCAN_MAX = 32 * 1024 * 1024
RESURRECT = os.path.join(HOME, '.local/share/tmux/resurrect')
TMUX_LOG = os.path.join(HOME, '.local/state/claude-sessions/tmux.tsv')
NAME_MAX, CWD_MAX = 32, 40
ALT_ROWS = 5         # panel: ALT keeps up to this many rows, MAIN gets the rest

_meta_cache = {}     # transcript path -> ((mtime_ns, size), meta)
_resurrect = {'files': set(), 'panes': {}, 'start': None}
_tmux_log = {'key': None, 'map': {}}


# ---- transcripts -----------------------------------------------------------

def _lines(path, start, length):
    with open(path, 'rb') as f:
        f.seek(start)
        data = f.read(length)
    for raw in data.split(b'\n'):
        if raw.startswith(b'{'):
            try:
                yield json.loads(raw)
            except ValueError:
                pass  # partial first/last line of a chunk


def _scan_meta(lines, meta):
    for d in lines:
        t = d.get('type')
        if t == 'custom-title' and d.get('customTitle'):
            meta['custom'] = d['customTitle']
        elif t == 'ai-title' and d.get('aiTitle'):
            meta['ai'] = d['aiTitle']
        elif t == 'last-prompt' and d.get('lastPrompt'):
            meta['prompt'] = d['lastPrompt']
        elif t == 'summary' and d.get('summary'):
            meta.setdefault('ai', d['summary'])


def _read_meta(path, size):
    meta = {}
    for d in _lines(path, 0, HEAD):
        if d.get('cwd'):
            meta['cwd'] = d['cwd']
            break
    _scan_meta(_lines(path, max(0, size - TAIL), TAIL), meta)
    if not (meta.get('custom') or meta.get('ai')) and TAIL < size <= FULL_SCAN_MAX:
        _scan_meta(_lines(path, 0, size), meta)
    return meta


# ---- tmux evidence ---------------------------------------------------------
# Claude writes <config>/sessions/<pid>.json while running ("tmux" key only
# inside tmux) and deletes it on a clean exit, so what we see is appended to
# TMUX_LOG to outlive the process. Older sessions: tmux-resurrect snapshots
# hold each Claude pane's title (= session name) and cwd.

def _alive(d):
    try:
        stat = open(f"/proc/{d['pid']}/stat").read()
    except (OSError, KeyError):
        return False
    # pid reuse guard: start time must match what claude recorded
    return str(d.get('procStart')) == stat.rsplit(') ', 1)[1].split()[19]


def _merge(m, sid, tmux):
    # "was in tmux": a name beats '' (seen outside tmux), later names win
    if tmux or sid not in m:
        m[sid] = tmux


def _load_tmux_log():
    try:
        st = os.stat(TMUX_LOG)
    except OSError:
        return _tmux_log['map']
    key = (st.st_mtime_ns, st.st_size)
    if key != _tmux_log['key']:
        m = {}
        for line in open(TMUX_LOG):
            sid, _, tmux = line.rstrip('\n').partition('\t')
            if sid:
                _merge(m, sid, tmux)
        _tmux_log.update(key=key, map=m)
    return _tmux_log['map']


def _record_tmux(seen):
    logged = _load_tmux_log()
    new = [(s, t) for s, t in seen.items() if s not in logged or (t and logged[s] != t)]
    if not new:
        return
    try:
        os.makedirs(os.path.dirname(TMUX_LOG), exist_ok=True)
        with open(TMUX_LOG, 'a') as f:
            f.write(''.join(f'{s}\t{t}\n' for s, t in new))
    except OSError:
        return
    for s, t in new:
        _merge(logged, s, t)


def _live_and_seen():
    """-> ({sessionId: status} for running sessions, {sessionId: tmux name or ''})"""
    live, seen, files = {}, {}, []
    for _, _, cdir in CONFIGS:
        sdir = os.path.join(cdir, 'sessions')
        try:
            names = os.listdir(sdir)
        except OSError:
            continue
        for n in names:
            if n.endswith('.json'):
                try:
                    files.append(json.load(open(os.path.join(sdir, n))))
                except (OSError, ValueError):
                    pass
    for d in sorted(files, key=lambda d: d.get('startedAt') or 0):
        sid = d.get('sessionId')
        if not sid:
            continue
        _merge(seen, sid, (d.get('tmux') or '').split(':')[0])
        if _alive(d):
            live[sid] = d.get('status') or 'live'
    return live, seen


def _resurrect_panes():
    """-> ({(pane title, cwd): tmux session}, time of the first snapshot)"""
    try:
        names = sorted(n for n in os.listdir(RESURRECT) if n.startswith('tmux_resurrect_'))
    except OSError:
        names = []
    r = _resurrect
    for n in names:
        if n in r['files']:
            continue
        r['files'].add(n)
        try:
            ts = time.mktime(time.strptime(n[15:30], '%Y%m%dT%H%M%S'))
            lines = open(os.path.join(RESURRECT, n)).read().splitlines()
        except (OSError, ValueError):
            continue
        r['start'] = ts if r['start'] is None else min(r['start'], ts)
        for line in lines:
            f = line.split('\t')
            if len(f) < 11 or f[0] != 'pane' or 'claude' not in (f[9] + f[10]):
                continue
            title = f[6]
            if title[:1] and not title[0].isalnum() and ' ' in title:
                title = title.split(' ', 1)[1]  # drop claude's status glyph
            r['panes'][(title, f[7].lstrip(':'))] = f[1]  # sorted by time: newest wins
    return r['panes'], r['start']


# ---- rows ------------------------------------------------------------------

def sessions():
    """One dict per transcript, newest first."""
    live, seen = _live_and_seen()
    _record_tmux(seen)
    exact = _load_tmux_log()
    panes, since = _resurrect_panes()
    rows = []
    for label, cmd, cdir in CONFIGS:
        pdir = os.path.join(cdir, 'projects')
        try:
            projects = os.listdir(pdir)
        except OSError:
            continue
        for proj in projects:
            try:
                entries = list(os.scandir(os.path.join(pdir, proj)))
            except OSError:
                continue
            for e in entries:
                if not (e.name.endswith('.jsonl') and e.is_file()):
                    continue
                st = e.stat()
                key = (st.st_mtime_ns, st.st_size)
                hit = _meta_cache.get(e.path)
                if hit and hit[0] == key:
                    meta = hit[1]
                else:
                    meta = _read_meta(e.path, st.st_size)
                    _meta_cache[e.path] = (key, meta)
                if not (meta.get('custom') or meta.get('ai') or meta.get('prompt')):
                    continue  # never got a real prompt (e.g. opened and quit)
                sid = e.name[:-6]
                cwd = meta.get('cwd') or proj.replace('-', '/')  # lossy fallback
                # tmux: exact name > snapshot pane with this name+cwd > exact '' >
                # '' if snapshots were running then, else '?' (no record)
                tmux = exact.get(sid) or next((panes[(t, cwd)] for t in (meta.get('custom'), meta.get('ai'))
                                               if (t, cwd) in panes), None)
                if tmux is None:
                    tmux = exact.get(sid)
                if tmux is None:
                    tmux = '' if since and st.st_mtime >= since else '?'
                rows.append({
                    'section': label, 'cmd': cmd, 'id': sid, 'mtime': st.st_mtime, 'cwd': cwd,
                    'name': meta.get('custom') or meta.get('ai') or sid[:8],
                    'ai': meta.get('ai') or '', 'prompt': meta.get('prompt') or '',
                    'tmux': tmux, 'state': live.get(sid),
                })
    rows.sort(key=lambda r: r['mtime'], reverse=True)
    return rows


def grouped(rows):
    """Collapse sessions sharing section, name and folder into one row
    (the running one, else the newest) carrying a count."""
    groups = {}
    for r in rows:  # newest first
        k = (r['section'], r['name'], r['cwd'])
        g = groups.get(k)
        if g is None:
            groups[k] = dict(r, n=1)
        else:
            g['n'] += 1
            if r['state'] and not g['state']:
                g.update(r, n=g['n'], mtime=g['mtime'])
    return list(groups.values())


def matches(r, terms):
    hay = ' '.join((r['name'], r['ai'], r['prompt'], r['cwd'], r['id'])).lower()
    return all(t in hay for t in terms)


# ---- table (shared by CLI and panel) ---------------------------------------

def tilde(p):
    return '~' + p[len(HOME):] if p == HOME or p.startswith(HOME + '/') else p


def short_path(p):
    p = tilde(p)
    if len(p) > CWD_MAX:
        parts = p.split('/')
        p = '/'.join(parts[:1] + ['…'] + parts[-2:])
    return p


def when(ts, now=None):
    now = now or time.time()
    t, n = time.localtime(ts), time.localtime(now)
    if t[:3] == n[:3]:
        return time.strftime('%H:%M', t)
    if now - ts < 6 * 86400:
        return time.strftime('%a %H:%M', t)
    return time.strftime('%d %b', t).lstrip('0')


def cells(r, now=None):
    name = r['name'] if len(r['name']) <= NAME_MAX else r['name'][:NAME_MAX - 1] + '…'
    if r['n'] > 1:
        name += f" ({r['n']})"
    tmux = r['tmux'] if r['tmux'] != '?' else ''  # '?' is said once, in the header
    # variable-width cwd last, as in the SSH readout: overflow only trims its tail
    return ['  ' + when(r['mtime'], now), name, r['state'] or '',
            'tmux=' + tmux if tmux else '', 'cwd=' + short_path(r['cwd'])]


def table(rows, max_lines=None, per_section=25, now=None):
    """-> lines: str (header, section title, blank) or (cells, row) for a
    session. max_lines fits the panel height; else per_section rows (0 = all)."""
    secs = [(label, cmd, cdir, [r for r in rows if r['section'] == label])
            for label, cmd, cdir in CONFIGS if os.path.isdir(cdir)]
    if max_lines is not None:
        room = max_lines - 2 - 2 * len(secs) + 1   # header+blank, titles, blanks between
        if len(secs) == 2:
            alt = min(max(1, len(secs[1][3])), ALT_ROWS)
            main = max(1, min(len(secs[0][3]), room - alt))
            takes = [main, max(1, room - main)]
        else:
            takes = [max(1, room)] * len(secs)
    else:
        takes = [per_section or None] * len(secs)
    head = 'CLAUDE SESSIONS  -  by last activity'
    if _resurrect['start']:
        head += '  -  tmux recorded since ' + when(_resurrect['start'], now)
    out = [head, '']
    for i, ((label, cmd, cdir, rs), take) in enumerate(zip(secs, takes)):
        if i:
            out.append('')
        out.append(f'{label:<9} ({cmd} -> {short_path(cdir)})')
        out.extend([(cells(r, now), r) for r in rs[:take]] or ['  (none)'])
    return out


def main(argv):
    n, resume, tsv, terms = 25, False, False, []
    it = iter(argv)
    for a in it:
        if a in ('-n', '--limit'):
            n = int(next(it))
        elif a in ('-r', '--resume'):
            resume = True
        elif a == '--tsv':
            tsv = True
        elif a in ('-h', '--help'):
            print(__doc__.rstrip()); return 0
        else:
            terms.append(a.lower())
    rows = grouped(sessions())
    if terms:
        rows = [r for r in rows if matches(r, terms)]
    fit = os.environ.get('LINES', '') if tsv else ''
    lines = table(rows, max_lines=int(fit) if fit.isdigit() else None, per_section=n)
    width = {}
    for ln in lines:
        if isinstance(ln, tuple):
            for i, c in enumerate(ln[0]):
                width[i] = max(width.get(i, 0), len(c))
    for ln in lines:
        if isinstance(ln, str):
            print(ln)
            continue
        c, r = ln
        if tsv:
            print('\t'.join(c))
        else:
            print('   '.join(x.ljust(width[i]) for i, x in enumerate(c)).rstrip())
        if resume:
            print(f"     cd {tilde(r['cwd'])} && {r['cmd']} --resume {r['id']}")
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
